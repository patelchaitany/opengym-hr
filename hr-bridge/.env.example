# ---------------------------------------------------------------------------
# fitbit-air configuration. Copy to `.env` and fill in what you need.
# Nothing here is required for live Bluetooth heart rate — that works offline.
# ---------------------------------------------------------------------------

# HTTP + WebSocket server
PORT=3000
HOST=127.0.0.1

# --- Bluetooth (optional filters) ---------------------------------------
# Restrict connection to a specific device by (case-insensitive) name substring
# or exact BLE address/UUID. Leave blank to connect to the first heart-rate
# device found. The Fitbit Air usually advertises as "Fitbit Air".
BLE_NAME_FILTER=
BLE_ADDRESS_FILTER=

# --- Google Health API (optional, for steps + history) ------------------
# Create a "Desktop app" OAuth client in Google Cloud Console and enable the
# Google Health API. See docs/GOOGLE_HEALTH_SETUP.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect used by the local OAuth flow.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback

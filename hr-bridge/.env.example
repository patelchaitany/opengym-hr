# ---------------------------------------------------------------------------
# hr-bridge configuration. Copy to `.env` and fill in what you need.
# Nothing here is required for live Bluetooth heart rate — that works offline,
# with no account and no file at all. Every value below is already the default.
# ---------------------------------------------------------------------------

# HTTP + WebSocket server.
# 3001, not 3000: in this repo openGym's API owns 3000.
PORT=3001
# 0.0.0.0 so a phone on the same Wi-Fi can reach the bridge — which is the whole
# point if you use openGym on your phone or from the Android app. Set to
# 127.0.0.1 to keep the bridge on this machine only.
HOST=0.0.0.0

# --- Bluetooth (optional filters) ---------------------------------------
# Restrict connection to a specific device by (case-insensitive) name substring
# or exact BLE address/UUID. Leave blank to connect to the first heart-rate
# device found — which is what you want unless the gym's treadmill is also
# broadcasting. Find the exact name/address with `npm run scan`.
BLE_NAME_FILTER=
BLE_ADDRESS_FILTER=

# --- Development ---------------------------------------------------------
# Stream a simulated lifting session instead of touching the radio. Lets you run
# and test the whole pipeline with no strap and no Bluetooth. `npm run start:sim`
# sets this for you.
HR_SIMULATE=

# Which origin may call the bridge from a browser. Default is open: the payload
# is a bpm number and there is nothing here to steal. Set to e.g.
# http://localhost:8080 to pin it.
HR_CORS_ORIGIN=*

# How much history the bridge keeps so openGym can ask for the samples that fell
# inside a set it just finished. Seconds; 4 h covers any session.
HR_RETENTION_SEC=14400

# --- Google Health API (optional, for steps + history) ------------------
# ONLY needed for steps/sleep/history, which do not come over Bluetooth. Live
# heart rate — everything openGym uses — needs none of this.
# Create a "Desktop app" OAuth client in Google Cloud Console and enable the
# Google Health API. See docs/GOOGLE_HEALTH_SETUP.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect used by the local OAuth flow. Must match the port above and
# the redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/oauth/callback
